# ============================================================
# 多智能体协同决策系统 - 环境变量配置
# 复制本文件为 .env 并填入实际值
# ============================================================

# --- LLM API配置 ---
# 中档模型（候选生成/审核/资源生成）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 高档模型（聚焦输出/裁判团裁决）
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 低档模型（轻量判断）
OPENAI_MINI_MODEL=gpt-4o-mini

# --- 数据库配置 ---
DB_PATH=data/wolegedou.db

# --- 向量知识库配置 ---
CHROMA_DB_PATH=data/chroma_db
EMBEDDING_MODEL=BAAI/bge-m3
KB_TOP_K=3
KB_SCORE_THRESHOLD=0.6
KB_DOCS_PATH=data/raw_docs          # 领域文档原始目录（队友放的 .md/.txt/.pdf 文档）
KB_COLLECTION_NAME=wolegedou_kb     # ChromaDB collection 名

# 知识库后端选择（numpy 优先预计算数据，启动快、免 ChromaDB）
#   auto   - 自动选：有 numpy 数据用 numpy，否则试 chroma，都失败降级 stub
#   numpy  - 强制用预计算向量数据（需先下载放到 KB_NUMPY_DIR）
#   chroma - 强制用 ChromaDB（需 pip install chromadb + FlagEmbedding）
KB_BACKEND=auto
KB_NUMPY_DIR=data/numpy_kb          # 预计算向量数据目录（从网盘下载后放这里，详见 README「知识库数据部署」）

# 混合检索（方案书 6.6 节：稠密+稀疏混合模式）
# true: dense(bge-m3 cosine) + sparse(BM25) → RRF 融合，提升关键词精确匹配召回
# false: 纯稠密检索（降级模式）
KB_HYBRID_SEARCH=true
KB_RRF_K=60                         # RRF 融合参数 k（业界默认 60）
KB_QUERY_EXPANSION=true             # 查询扩展+术语映射（v7.0），中英术语互译提升跨语言召回

# --- 服务配置 ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=DEBUG

# --- 贡献记忆配置 ---
EMA_SMOOTH=0.8
ALPHA_INITIAL=0.9
ELIMINATION_THRESHOLD=0.5
ELIMINATION_CONSECUTIVE_COUNT=3

# --- 超时配置（秒） ---
LLM_TIMEOUT=120
FSM_MAX_REVISIONS=2

# --- CORS / 安全 ---
# 逗号分隔的允许源列表，留空则用默认 localhost 白名单
# CORS_ORIGINS=["https://your-domain.com"]
# 简单 API Key 认证（空=不启用；启用后客户端需带 X-API-Key 头）
API_KEY=
# 每个客户端每分钟最大请求数（0=不限流）
RATE_LIMIT_PER_MINUTE=60

# --- 数据合规（方案书 7.4 节）---
# 对话历史保留天数，过期自动清除
CONVERSATION_RETENTION_DAYS=30

# --- 离线演示缓存（附录 E）---
# 启用后 /api/ask 优先查 demo_cache 表，命中则不走 LLM
DEMO_CACHE_ENABLED=false
