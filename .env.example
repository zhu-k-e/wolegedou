# ============================================================
# 多智能体协同决策系统 - 环境变量配置
# 复制本文件为 .env 并填入实际值
# ============================================================

# --- LLM API配置 ---
# 中档模型（候选生成/审核/资源生成）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 高档模型（聚焦输出/裁判团裁决）
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 低档模型（轻量判断）
OPENAI_MINI_MODEL=gpt-4o-mini

# --- 数据库配置 ---
DB_PATH=data/wolegedou.db

# --- 向量知识库配置（知识库团队维护） ---
CHROMA_DB_PATH=data/chroma_db
EMBEDDING_MODEL=BAAI/bge-m3
KB_TOP_K=3
KB_SCORE_THRESHOLD=0.6

# --- 服务配置 ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=DEBUG

# --- 贡献记忆配置 ---
EMA_SMOOTH=0.8
ALPHA_INITIAL=0.9
ELIMINATION_THRESHOLD=0.5
ELIMINATION_CONSECUTIVE_COUNT=3

# --- 超时配置（秒） ---
LLM_TIMEOUT=30
FSM_MAX_REVISIONS=2
