def auto_adjust(input_path, output_path=None):
    """自动亮度调整"""
    print(f"   🔧 执行自动亮度调整...")
    
    img = safe_imread(input_path)
    if img is None:
        print(f"   ❌ 无法读取图像")
        return None
    
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    current_brightness = np.mean(gray)
    
    if current_brightness < 1:
        current_brightness = 1
    
    target_brightness = 128
    gamma = np.log(target_brightness / 255.0) / np.log(current_brightness / 255.0)
    gamma = np.clip(gamma, 0.3, 3.0)
    
    print(f"   📊 当前亮度: {current_brightness:.1f}, 计算 Gamma: {gamma:.2f}")
    
    result = apply_gamma(img, gamma)
    
    if output_path:
        safe_imwrite(output_path, result)
        print(f"   ✅ 自动调整结果已保存: {output_path}")
    
    return result
