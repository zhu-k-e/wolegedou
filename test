import cv2
import numpy as np
import os
from PIL import Image


def safe_imread(image_path):
    """安全读取图像"""
    if not os.path.exists(image_path):
        return None
    
    try:
        with open(image_path, 'rb') as f:
            data = np.frombuffer(f.read(), dtype=np.uint8)
            img = cv2.imdecode(data, cv2.IMREAD_COLOR)
            if img is not None:
                return img
    except:
        pass
    
    try:
        pil_img = Image.open(image_path)
        if pil_img.mode == 'RGBA':
            bg = Image.new('RGB', pil_img.size, (255, 255, 255))
            bg.paste(pil_img, mask=pil_img.split()[-1])
            pil_img = bg
        elif pil_img.mode != 'RGB':
            pil_img = pil_img.convert('RGB')
        img = cv2.cvtColor(np.array(pil_img), cv2.COLOR_RGB2BGR)
        return img
    except:
        pass
    
    return None


def safe_imwrite(image_path, img):
    """安全保存图像"""
    try:
        success, encoded = cv2.imencode('.png', img)
        if success:
            with open(image_path, 'wb') as f:
                f.write(encoded.tobytes())
            return True
    except:
        pass
    
    try:
        img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        pil_img = Image.fromarray(img_rgb)
        pil_img.save(image_path)
        return True
    except:
        return False


def apply_gamma(img, gamma=1.0):
    """应用 Gamma 校正"""
    if gamma == 1.0:
        return img.copy()
    
    inv_gamma = 1.0 / gamma
    table = np.array([(i / 255.0) ** inv_gamma * 255 for i in range(256)]).astype(np.uint8)
    return cv2.LUT(img, table)


def gamma_brighten(input_path, output_path=None, gamma=0.5):
    """Gamma 提亮"""
    print(f"   🔧 执行 Gamma 提亮 (gamma={gamma})...")
    
    img = safe_imread(input_path)
    if img is None:
        print(f"   ❌ 无法读取图像")
        return None
    
    result = apply_gamma(img, gamma)
    
    if output_path:
        safe_imwrite(output_path, result)
        print(f"   ✅ 提亮结果已保存: {output_path}")
    
    return result


def gamma_darken(input_path, output_path=None, gamma=1.5):
    """Gamma 压暗"""
    print(f"   🔧 执行 Gamma 压暗 (gamma={gamma})...")
    
